{
    "name": "essasabbgah/laravel-chat",
    "description": "Laravel Chat - Multi-tenant chat package with Reverb broadcasting, attachments, reactions, presence, and Flutter support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Essa Sabbagh",
            "email": "essasabbagh@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0",
        "larastan/larastan": "^2.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Essasabbagh\\LaravelChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Essasabbagh\\LaravelChat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Essasabbagh\\LaravelChat\\ChatServiceProvider"
            ]
        }
    }
}